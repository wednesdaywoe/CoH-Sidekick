{
  "name": "coh-sidekick",
  "version": "1.0.0",
  "description": "City of Heroes Character Build Planner",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rebirth": "vite --open /?serverId=rebirth",
    "build": "node --max-old-space-size=14336 node_modules/typescript/bin/tsc && node --max-old-space-size=14336 node_modules/vite/bin/vite.js build",
    "build:engine": "node scripts/build-engine.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "regen": "node scripts/regen-all.cjs",
    "regen:generated": "node scripts/regen-all.cjs --generated-only",
    "sync:bin-crawler": "./scripts/sync-bin-crawler.sh",
    "sync:shared": "node scripts/sync-shared.cjs",
    "audit:set-categories": "for ds in $(node -p \"require('./scripts/_dataset-paths.cjs').ALL_DATASETS.join(' ')\"); do node scripts/audit-allowed-set-categories.cjs --dataset \"$ds\" --gate || exit 1; done",
    "validate:converter": "for ds in $(node -p \"require('./scripts/_dataset-paths.cjs').ALL_DATASETS.join(' ')\"); do node scripts/validate-converter-output.cjs --dataset \"$ds\" --gate || exit 1; done",
    "validate:incarnate-collapse": "for ds in $(node -p \"require('./scripts/_dataset-paths.cjs').ALL_DATASETS.join(' ')\"); do node scripts/dsh8-incarnate-collapse-detector.cjs --dataset \"$ds\" --gate || exit 1; done",
    "test": "vitest run",
    "test:changed": "vitest run --changed HEAD",
    "build:test-datasets": "node scripts/build-dataset-bundles.mjs",
    "test:watch": "vitest",
    "import-mids": "tsx --env-file-if-exists=.env --import ./scripts/register-env-loader.mjs scripts/bulk-import-mids.ts",
    "delete-user-builds": "tsx --env-file-if-exists=.env --import ./scripts/register-env-loader.mjs scripts/delete-user-shared-builds.ts",
    "changelog:push": "tsx --env-file-if-exists=.env scripts/push-changelog-discord.ts",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "verify:sync": "node scripts/verify-sync.cjs --gate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wednesdaywoe/CoH-Sidekick.git"
  },
  "keywords": [
    "city-of-heroes",
    "coh",
    "build-planner",
    "mmorpg"
  ],
  "author": "Wednesdaywoe",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/wednesdaywoe/CoH-Sidekick/issues"
  },
  "homepage": "https://github.com/wednesdaywoe/CoH-Sidekick#readme",
  "dependencies": {
    "@sentry/react": "^10.53.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-router": "^1.150.0",
    "html-to-image": "^1.11.13",
    "nanoid": "^5.1.6",
    "pako": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.9",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
