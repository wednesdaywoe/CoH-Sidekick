{
  "name": "Refraction_Shield",
  "full_name": "Corruptor_Buff.Force_Field.Refraction_Shield",
  "short_name": "Refraction_Shield",
  "type": "Click",
  "display_name": "Barrier Field",
  "display_fullname": "Corruptor Buff Force Field Refraction Shield",
  "display_help": "Encases a target in a powerful Barrier Force Field. This power may be used on either an ally or a foe. If used on an ally, this grants them a strong amount of damage absorption for a brief time. The field does not hinder their actions and the protected ally can still move and attack normally. If used on an enemy the target will be captured. The captured target cannot be harmed, is Immobilized, and cannot attack or aid their allies. The target can, however, use powers on themselves. Captured targets are also still vulnerable to Knockback, Repel, and Attract effects from other Force Field powers. Recharge: Slow",
  "display_short_help": "Ranged, Ally +Absorb OR Foe Capture (Special)",
  "icon": "forcefield_refractionshield.png",
  "auto_issue": false,
  "auto_issue_keeps_level": false,
