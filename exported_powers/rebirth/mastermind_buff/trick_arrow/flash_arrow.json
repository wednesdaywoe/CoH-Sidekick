{
  "name": "Flash_Arrow",
  "full_name": "Mastermind_Buff.Trick_Arrow.Flash_Arrow",
  "short_name": "Flash_Arrow",
  "type": "Click",
  "display_name": "Flash Arrow",
  "display_fullname": "Mastermind Buff Trick Arrow Flash Arrow",
  "display_help": "This arrow explodes in a dazzling flash of light and sound. The targets are so blinded that they can hardly see a thing. Most villains will not be able to see past normal melee range, although some may have better perception. If the villains are attacked, they will be alerted to your presence, but will suffer a significant penalty to their chance to hit. Flash Arrow places the Dazzled effect on targets; Dazzled targets have reduced accuracy, and are less able to defend themselves and will suffer increased Resistance debuffs from Acid Arrow and Disruption Arrow, increased Defense debuffs from Acid Arrow and Oil Slick Arrow, and will have a greater chance to slip and fall when caught in an Oil Slick. The pyrotechnic flash of this arrow can also ignite flammable substances such as an Oil Slick. Flash Arrow is autohit against critter targets, but a To Hit check is required to affect enemy players. Recharge: Slow",
  "display_short_help": "Ranged (Targeted AoE), Foe -Visibility, -To Hit, Special",
  "icon": "trickarrow_blind.png",
  "auto_issue": false,
  "auto_issue_keeps_level": false,
  "free": false,
