{
  "name": "Energetic_Strike",
  "full_name": "Defender_Ranged.Kinetic_Assault.Energetic_Strike",
  "short_name": "Energetic_Strike",
  "type": "Click",
  "display_name": "Energetic Strike",
  "display_fullname": "Defender Ranged Kinetic Assault Energetic Strike",
  "display_help": "You form the potential energies around you into a massive surge of force that empowers your fists to deliver a devastating blow to a single target. This blow causes extreme smashing and energy damage on impact and will reduce the target's damage.  The force from this power's impact is so great that it is likely to disorient most foes. Energetic Strike awards 2 stacks of Impulse and and its damage debuff and damage scale with the number of consumed stacks.  If used when you have 5 stacks of Impulse, this power's stun effect will last longer and Energetic Strike has a chance to immediately refresh Coalescence.  Damage: Extreme, Recharge: Long",
  "display_short_help": "Melee, Extreme DMG (Smashing/Energy), Foe Disorient, -DMG, Self -Impulse",
